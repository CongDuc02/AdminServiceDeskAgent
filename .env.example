# Biến môi trường cho chạy local — chỉ TÊN và giá trị an toàn; không bao giờ điền secret thật vào file này.
# Bản thật là `.env` (gitignored). Bảng đầy đủ: docs/design/11-ops.md, mục Biến môi trường theo môi trường.

# Bắt buộc. dev | staging | prod — thiếu là bước kiểm khởi động #16 chặn (fail-closed, ADR-023).
BO19_ENVIRONMENT=dev

# Bắt buộc ở api/worker/cron: DSN của role bo19_app (không phải bo19_migrator, không phải bo19_admin — bước kiểm #2 chặn).
BO19_DATABASE_URL=

# Bắt buộc ở api: secret ký bo19_session (bước kiểm #12). Mỗi môi trường một giá trị riêng.
BO19_SESSION_SECRET=

# Không cần đặt — mặc định là giá trị WV (11-ops.md): PORT=10000, BO19_ORG_TIMEZONE=Asia/Ho_Chi_Minh,
# BO19_SHUTDOWN_DELAY_SECONDS=30, BO19_TURN_DEADLINE_SECONDS=20, BO19_TURN_DEADLINE_MARGIN_SECONDS=10,
# BO19_OBJECT_STORAGE_TIMEOUT_SECONDS=30, BO19_STORED_OBJECT_LEASE_SECONDS=120,
# BO19_ARGON2_TIME_COST=2, BO19_ARGON2_MEMORY_COST_KIB=19456, BO19_ARGON2_PARALLELISM=1.

# KHÔNG đặt bất kỳ biến nào có tên bắt đầu bằng LANGSMITH_ hoặc LANGCHAIN_ và chứa TRACING — bước kiểm #19 chặn.
